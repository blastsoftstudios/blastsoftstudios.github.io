---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for path in site.sitemap_pages %}
<url><loc>{{ site.url }}{{ path }}</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
{%- endfor %}
{%- assign docs = site.webapps | concat: site.downloads %}
{%- for doc in docs %}
<url><loc>{{ site.url }}{{ doc.url }}</loc><lastmod>{{ doc.updated | date: "%Y-%m-%d" }}</lastmod><priority>0.8</priority></url>
{%- endfor %}
</urlset>
